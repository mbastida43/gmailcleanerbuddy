{
  "name": "gmail-cleaner-buddy",
  "version": "2.1.0",
  "description": "Gmail Cleaner Buddy com OAuth2 e Gmail API",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json",
    "build:landing": "tsc -p tsconfig.landing.json",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "dev": "npm run build:client && concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon --watch src --ext ts --ignore src/client --exec ts-node src/server.ts",
    "dev:client": "tsc -p tsconfig.client.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.landing.json --noEmit",
    "audit": "npm audit --omit=dev"
  },
  "keywords": [
    "gmail",
    "cleaner",
    "oauth2",
    "google-api"
  ],
  "author": "Marlon Bastida",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.17.3",
    "googleapis": "^173.0.0",
    "helmet": "^8.2.0"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/express-session": "1.19.0",
    "@types/node": "22.20.0",
    "concurrently": "10.0.3",
    "nodemon": "^3.0.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}

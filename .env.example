# Gmail Cleaner Buddy — Configuração de ambiente (Twelve-Factor: III. Config)
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env (já está no .gitignore).

# Credenciais OAuth2 do Google Cloud Console
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Segredo da sessão — obrigatório, mínimo de 32 caracteres.
# Gere um valor forte com: openssl rand -hex 32
SESSION_SECRET=

# Porta do servidor (Twelve-Factor: VII. Port binding)
PORT=3000

# Em produção use NODE_ENV=production (ativa cookies "secure" e trust proxy)
NODE_ENV=development

# ============================================================
# Gmail Cleaner Buddy — variáveis de ambiente
# Copie este arquivo para .env e preencha. NUNCA versione o .env.
# ============================================================

# Credenciais OAuth2 do Google Cloud Console (APIs e Serviços > Credenciais)
GOOGLE_CLIENT_ID=cole-seu-client-id-aqui
GOOGLE_CLIENT_SECRET=cole-seu-client-secret-aqui

# Deve ser IDÊNTICO ao URI cadastrado no Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Segredo de sessão — 32+ caracteres. Gere com: openssl rand -hex 32
SESSION_SECRET=gere-um-segredo-forte-com-openssl-rand-hex-32

# Porta (opcional, padrão 3000)
PORT=3000

# Ambiente: development (padrão) ou production
NODE_ENV=development

# Quantas mensagens recentes entram na amostra que elege os candidatos a
# "ofensor" (opcional, padrão 1000, teto 25000).
#
# O custo é linear e tem piso: a cota do Gmail permite ~50 leituras por segundo,
# então o tempo mínimo da análise é MAX_ANALYZE/50 segundos.
#   500  -> ~10s     1000 -> ~20s     2000 -> ~40s     5000 -> ~100s
#
# Aumentar não revela remetentes escondidos — com ritmos estáveis, uma janela
# maior multiplica todos pelo mesmo fator e o ranking se mantém. O ganho real é
# estabilidade: janelas curtas deixam uma campanha pontual distorcer o topo.
MAX_ANALYZE=1000
